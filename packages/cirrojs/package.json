{
    "name": "cirrojs",
    "version": "0.0.32",
    "description": "React islands SSG with strict CSP (no unsafe-inline). Vite-based, MPA-first.",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/osawa-naotaka/cirro.git"
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "exports": {
        ".": "./src/lib/index.ts",
        "./server": "./src/server/server.ts",
        "./vite": "./src/vite/vite.ts",
        "./bin": "./src/runtime/cli.ts",
        "./layout": "./src/layout/layout.tsx",
        "./registry": {
            "browser": "./src/registry/registry.browser.ts",
            "default": "./src/registry/registry.ts"
        }
    },
    "bin": {
        "cirro": "public/cli.sh"
    },
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "./server": {
                "types": "./dist/server.d.ts",
                "default": "./dist/server.js"
            },
            "./vite": {
                "types": "./dist/vite.d.ts",
                "default": "./dist/vite.js"
            },
            "./bin": {
                "types": "./dist/cli.d.ts",
                "default": "./dist/cli.js"
            },
            "./layout": {
                "types": "./dist/layout.d.ts",
                "default": "./dist/layout.js"
            },
            "./registry": {
                "types": "./dist/registry.d.ts",
                "browser": "./dist/registry.browser.js",
                "default": "./dist/registry.js"
            }
        },
        "bin": {
            "cirro": "./dist/cli.sh"
        }
    },
    "scripts": {
        "build": "tsdown",
        "gen": "node script/genFontAwesomeDefs.ts && biome check --write ./src",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
        "format": "biome check --write ./src ./script ./test",
        "lint": "biome check ./src ./script ./test",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:coverage:runtime": "node script/coverageRuntime.ts"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "7.3.1",
        "hast-util-sanitize": "^5.0.2",
        "mdast-util-from-markdown": "^2.1.0",
        "mdast-util-to-string": "^4.0.0",
        "rehype-prism": "^2.3.3",
        "rehype-sanitize": "^6.0.0",
        "rehype-stringify": "^10.0.1",
        "remark-export-toc": "0.1.0-alpha.2",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "unified": "^11.0.5"
    },
    "peerDependencies": {
        "@vitejs/plugin-react": "^6.0.2",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "vite": "^8.2.2"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.8",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitest/coverage-v8": "5.1.0",
        "c8": "^12.0.0",
        "parse5": "^8.1.1",
        "tsdown": "^0.23.7",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    }
}
